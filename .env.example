# ===== AI 端点（可选）=====
# 这一组是「默认值」。设置页里填的优先级更高——日常改配置请直接在应用内改，
# 界面填了之后这三个就不生效了（不是报错，是设计如此）。
#
# 任何 OpenAI 格式的端点都可以，不限于 OpenAI 官方：
#   DeepSeek   https://api.deepseek.com/v1              模型 deepseek-chat
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4     模型 glm-4-plus     ← 注意是 /v4
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   本地 Ollama http://localhost:11434/v1               模型 llama3.2（本地端点不需要 Key）
# 应用内的「AI 配置」里有一排预设按钮，点一下会自动填好地址和模型。
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 填了自定义 OPENAI_BASE_URL 就必须填它：各家模型名不一样，没有通用默认值。
# 留空且 OPENAI_BASE_URL 也为空时，回落到 OpenAI 官方的 gpt-4o-mini。
MODEL_NAME=
GITHUB_TOKEN=
# GitHub OAuth App 的 Client ID（不是 secret，Device Flow 不需要 secret）。
# 注册见 README「用 GitHub 登录」，必须勾上 Enable Device Flow。
GITHUB_OAUTH_CLIENT_ID=
MOCK_MODE=false
